# Base URL of the Sensei API.
# On a simulator, localhost works. On a physical device, use your machine's
# LAN IP (e.g. http://192.168.1.20:3000) so the phone can reach the API.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Clerk publishable key (issue #3 / decision L.6). Public by design — safe to
# ship in the client bundle. Leave blank to run in dev-stub mode (no auth gate,
# matching the API's dev-stub mode). Get it from the Clerk dashboard.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
