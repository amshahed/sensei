// Prisma schema for the Sensei API.
//
// Sketch + iterate (decisions E.4 / F.0): common fields are columns; type-specific
// item attributes live in `data` (Json) for now. Mastery + FSRS state attach to
// items per-user (D.1 / G.1 / G.2). Item ids are language-prefixed (CC.1).
// The `vector` extension (pgvector) is enabled for reference-corpus embeddings
// (E.3 / L.3), which land in a later issue.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------- Enums ----------------

enum ItemType {
  KANA
  VOCAB
  KANJI
  GRAMMAR
}

enum LessonType {
  // Foundational (single-concept) lessons
  F_KANA
  F_VOCAB
  F_KANJI
  F_GRAMMAR
  // Integration (multi-modality) lessons
  I_LISTENING
  I_SPEAKING
  I_READING
  I_WRITING
  I_SCENARIO
  // Meta lessons
  REVIEW
  ASSESSMENT
}

enum CheckFormat {
  MULTIPLE_CHOICE
  TYPED
  SPOKEN
}

enum LessonItemRole {
  TARGET
  SUPPORTING
}

// ---------------- Content ----------------

/// First-class learnable unit. Mastery attaches here, not to lessons (D.1).
model Item {
  id        String   @id // language-prefixed, e.g. "ja:kana:a" (CC.1)
  language  String // "ja"
  type      ItemType
  display   String // surface form, e.g. "あ", "猫"
  reading   String? // kana reading, e.g. "ねこ"
  meaning   String? // gloss, e.g. "cat"
  data      Json     @default("{}") // type-specific attributes (E.4 sketch+iterate)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonLinks   LessonItem[]
  checks        Check[]
  masteryStates ItemMasteryState[]

  @@index([language, type])
}

model Module {
  id        String   @id @default(cuid())
  language  String
  slug      String   @unique
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters Chapter[]

  @@index([language, position])
}

model Chapter {
  id        String   @id @default(cuid())
  moduleId  String
  slug      String   @unique
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module  Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([moduleId, position])
}

model Lesson {
  id               String     @id @default(cuid())
  chapterId        String
  slug             String     @unique
  title            String
  type             LessonType
  position         Int
  estimatedMinutes Int?
  teach            Json       @default("{}") // authored Teach beat (B.2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  chapter Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  items   LessonItem[]
  checks  Check[]

  @@index([chapterId, position])
}

/// Join: which items a lesson covers, and in what role.
model LessonItem {
  id       String         @id @default(cuid())
  lessonId String
  itemId   String
  role     LessonItemRole @default(TARGET)
  position Int            @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([lessonId, itemId])
  @@index([itemId])
}

/// A single Check-beat question targeting one item.
model Check {
  id           String      @id @default(cuid())
  lessonId     String
  position     Int
  prompt       String
  format       CheckFormat @default(MULTIPLE_CHOICE)
  targetItemId String
  data         Json        @default("{}") // e.g. { choices: [...], answer: "..." }; answer is server-only
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  targetItem Item   @relation(fields: [targetItemId], references: [id])

  @@index([lessonId, position])
}

// ---------------- Learners + mastery (D.1 / G.1 / G.2) ----------------

model User {
  id        String   @id // Clerk user id (auth wired in #3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  masteryStates ItemMasteryState[]
}

/// Per-(user, item) mastery + spaced-repetition state.
model ItemMasteryState {
  id          String    @id @default(cuid())
  userId      String
  itemId      String
  mastery     Float     @default(0) // continuous 0..1 (G.1)
  recognition Float     @default(0) // per-modality breadcrumbs (G.1)
  recall      Float     @default(0)
  production  Float     @default(0)
  fsrs        Json      @default("{}") // FSRS scheduler state (G.2); typed in #5/#6
  due         DateTime?
  lastReview  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, due])
}
