// Prisma schema for the Sensei API.
//
// Sketch + iterate (decisions E.4 / F.0): common fields are columns; type-specific
// item attributes live in `data` (Json) for now. Mastery + FSRS state attach to
// items per-user (D.1 / G.1 / G.2). Item ids are language-prefixed (CC.1).
// The `vector` extension (pgvector) is enabled for reference-corpus embeddings
// (E.3 / L.3), which land in a later issue.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------- Enums ----------------

enum ItemType {
  KANA
  VOCAB
  KANJI
  GRAMMAR
}

enum LessonType {
  // Foundational (single-concept) lessons
  F_KANA
  F_VOCAB
  F_KANJI
  F_GRAMMAR
  // Integration (multi-modality) lessons
  I_LISTENING
  I_SPEAKING
  I_READING
  I_WRITING
  I_SCENARIO
  // Meta lessons
  REVIEW
  ASSESSMENT
}

enum CheckFormat {
  MULTIPLE_CHOICE
  TYPED
  SPOKEN
}

enum LessonItemRole {
  TARGET
  SUPPORTING
}

// ---------------- Content ----------------

/// First-class learnable unit. Mastery attaches here, not to lessons (D.1).
model Item {
  id        String   @id // language-prefixed, e.g. "ja:kana:a" (CC.1)
  language  String // "ja"
  type      ItemType
  display   String // surface form, e.g. "あ", "猫"
  reading   String? // kana reading, e.g. "ねこ"
  meaning   String? // gloss, e.g. "cat"
  data      Json     @default("{}") // type-specific attributes (E.4 sketch+iterate)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonLinks   LessonItem[]
  checks        Check[]
  masteryStates ItemMasteryState[]

  @@index([language, type])
}

model Module {
  id        String   @id @default(cuid())
  language  String
  slug      String   @unique
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters Chapter[]

  @@index([language, position])
}

model Chapter {
  id        String   @id @default(cuid())
  moduleId  String
  slug      String   @unique
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module          Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons         Lesson[]
  marks           UserChapterMark[]
  currentForUsers User[]              @relation("UserCurrentChapter")
  assessments     AssessmentAttempt[]

  @@index([moduleId, position])
}

model Lesson {
  id               String     @id @default(cuid())
  chapterId        String
  slug             String     @unique
  title            String
  type             LessonType
  position         Int
  estimatedMinutes Int?
  teach            Json       @default("{}") // authored Teach beat (B.2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  chapter     Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  items       LessonItem[]
  checks      Check[]
  completions LessonCompletion[]
  skips       UserLessonSkip[]

  @@index([chapterId, position])
}

/// Join: which items a lesson covers, and in what role.
model LessonItem {
  id       String         @id @default(cuid())
  lessonId String
  itemId   String
  role     LessonItemRole @default(TARGET)
  position Int            @default(0)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([lessonId, itemId])
  @@index([itemId])
}

/// A single Check-beat question targeting one item.
model Check {
  id           String      @id @default(cuid())
  lessonId     String
  position     Int
  prompt       String
  format       CheckFormat @default(MULTIPLE_CHOICE)
  targetItemId String
  data         Json        @default("{}") // e.g. { choices: [...], answer: "..." }; answer is server-only
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lesson     Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  targetItem Item   @relation(fields: [targetItemId], references: [id])

  @@index([lessonId, position])
}

// ---------------- Reference corpus (E.3 / L.3 pgvector) ----------------

/// Embedded reference passage for RAG-grounded authoring (E.3).
/// Insertions go via $executeRaw because the vector column is Unsupported.
model ReferenceDoc {
  id        String                       @id @default(cuid())
  source    String // "tatoeba", "grammar-ref"
  language  String // "ja"
  text      String
  embedding Unsupported("vector(1024)")?
  metadata  Json                         @default("{}")
  createdAt DateTime                     @default(now())

  @@index([source, language])
}

// ---------------- Learners + mastery (D.1 / G.1 / G.2) ----------------

model User {
  id        String   @id // Clerk user id (auth wired in #3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Curriculum position override — "relocate position here" (I.4.e). Null =
  /// the learner's frontier: the first chapter not yet completed or skipped.
  currentChapterId String?
  currentChapter   Chapter? @relation("UserCurrentChapter", fields: [currentChapterId], references: [id], onDelete: SetNull)

  masteryStates      ItemMasteryState[]
  completions        LessonCompletion[]
  chapterMarks       UserChapterMark[]
  lessonSkips        UserLessonSkip[]
  assessmentAttempts AssessmentAttempt[]
  practiceSessions   PracticeSession[]

  /// Signup intake (I.3.b), null until the survey is submitted.
  /// Q1 — what pulled them to Japanese (`Interest` values; JLPT intent derives from it).
  interests          String[]          @default([])
  /// Q2 — routes placement (I.3.d).
  priorExperience    PriorExperience?
  /// Q3 — daily commitment in minutes (5 / 10 / 20 / 30).
  dailyTargetMinutes Int?
  intakeCompletedAt  DateTime?
  placementAttempt   PlacementAttempt?

  /// Learning streak (K.2/K.3.f). IANA timezone the app reports; days are
  /// the learner's local calendar dates (UTC until known).
  timezone                    String?
  /// Banked streak-freezes, earned by over-delivering (K.3.a; capped).
  streakFreezes               Int        @default(0)
  /// Last "not now" on a target-recalibration suggestion (K.3.c).
  targetSuggestionDismissedAt DateTime?
  studyDays                   StudyDay[]

  /// Reminders (K.3.d/K.3.g), scheduled on the phone from a server-built
  /// plan. Off until the learner opts in. Times are minutes after local
  /// midnight.
  remindersOn      Boolean   @default(false)
  reminderMinute   Int       @default(1080)
  eveningReminder  Boolean   @default(true)
  quietStartMinute Int       @default(1320)
  quietEndMinute   Int       @default(480)
  /// When the in-context offer was answered (Turn on / Not now): asked once.
  remindersAskedAt DateTime?
}

/// Signup Q2 (I.3.b): drives placement routing (I.3.d).
enum PriorExperience {
  NONE // total beginner: no placement
  SOME_KANA // kana-only placement
  FAIR_AMOUNT // full placement
  REFRESHER // full placement
}

enum PlacementTier {
  KANA
  FULL
}

enum PlacementStatus {
  IN_PROGRESS
  COMPLETED // ended at the first miss, or ran out of questions
  SKIPPED // learner chose to start from the beginning
}

/// How a chapter was passed (I.4.e.a / I.4.d.a). Lesson completions alone
/// never pass a chapter — the Assessment is its last step.
enum ChapterMarkKind {
  SKIPPED_VIA_PLACEMENT // placement inferred the chapter as known (I.4.c, #13)
  PASSED_ASSESSMENT // learner passed the chapter Assessment — skip-test or exit (I.4.d.a)
}

/// One mark per (user, chapter) — written by placement (#13) and skip-test (#15),
/// read by the Curriculum Outline (#14, I.4.e).
model UserChapterMark {
  userId    String
  chapterId String
  kind      ChapterMarkKind
  createdAt DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@index([chapterId])
}

/// A lesson collapsed by a partial skip-test pass: every one of its TARGET
/// items was sampled and answered correctly (I.4.d.a). Snapshotted, so mastery
/// decay never un-skips it.
model UserLessonSkip {
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
}

/// SKIP = taken before the chapter's lessons were all done; EXIT = after.
enum AssessmentKind {
  SKIP
  EXIT
}

enum AssessmentStatus {
  IN_PROGRESS
  PASSED
  FAILED
}

/// One chapter Assessment attempt (I.4.d.a). The sampled items are fixed
/// server-side at start; the learner submits all answers once.
model AssessmentAttempt {
  id           String           @id @default(cuid())
  userId       String
  chapterId    String
  kind         AssessmentKind
  status       AssessmentStatus @default(IN_PROGRESS)
  itemIds      String[]
  correctCount Int?
  /// Per-item grading, written on submit: [{ itemId, answer, correct, correctAnswer }]
  results      Json?
  createdAt    DateTime         @default(now())
  submittedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, chapterId])
  @@index([chapterId])
}

/// Records that a user finished a lesson (the Check beat all the way through).
/// One row per (user, lesson); re-completing just refreshes completedAt.
model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
}

/// Per-(user, item) mastery + spaced-repetition state.
model ItemMasteryState {
  id          String    @id @default(cuid())
  userId      String
  itemId      String
  mastery     Float     @default(0) // continuous 0..1 (G.1)
  recognition Float     @default(0) // per-modality breadcrumbs (G.1)
  recall      Float     @default(0)
  production  Float     @default(0)
  fsrs        Json      @default("{}") // FSRS scheduler state (G.2); typed in #5/#6
  due         DateTime?
  lastReview  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId, due])
}

/// A Practice Mode drill (J.1): learned items in a learner-picked scope,
/// weakest first. Never advances the curriculum (J.1.a).
model PracticeSession {
  id        String   @id @default(cuid())
  userId    String
  /// The scope picked: { kind: 'weakest' | 'module' | 'chapter', id?, types? }
  scope     Json
  itemIds   String[]
  createdAt DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts PracticeAttempt[]

  @@index([userId, createdAt])
}

/// First answer to an item within a Practice session — the double-count
/// guardrail (J.1.c): only this one updates FSRS; repeats are exposure-only.
model PracticeAttempt {
  sessionId String
  itemId    String
  correct   Boolean
  createdAt DateTime @default(now())

  session PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, itemId])
}

/// The signup placement quiz (I.4.f) — at most one per learner. Questions
/// (with their answers) stay server-side; the learner answers them in course
/// order and the quiz ends at the first miss.
model PlacementAttempt {
  id             String          @id @default(cuid())
  userId         String          @unique
  tier           PlacementTier
  status         PlacementStatus @default(IN_PROGRESS)
  /// Ordered questions: [{ itemId, chapterId, type, prompt, display, parts: [{ label, choices, answer }] }].
  questions      Json
  /// One entry per answered question, in order: [{ itemId, correct }].
  answers        Json            @default("[]")
  /// Compare-and-set guard: answers are accepted strictly in order.
  answered       Int             @default(0)
  /// Where the learner starts (null = nothing left / skipped to the beginning).
  startChapterId String?
  createdAt      DateTime        @default(now())
  completedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One learner-local day of study (K.3.f): effort credited from real work, and
/// whether the day was done (reviews cleared + effort ≥ target) or covered by
/// a freeze. The streak is the run of done-or-frozen days.
model StudyDay {
  userId          String
  /// Learner-local calendar date, YYYY-MM-DD.
  localDate       String
  /// Credited effort (lesson estimates + 20s per answer), not stopwatch time.
  effortSeconds   Int       @default(0)
  /// Review answers today — a full G.4 session clears a backlog for the day.
  reviewsAnswered Int       @default(0)
  done            Boolean   @default(false)
  doneAt          DateTime?
  /// Covered by a banked freeze instead of being done.
  frozen          Boolean   @default(false)
  /// This day already banked its freeze (2× target), so it can't bank twice.
  freezeEarned    Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, localDate])
}
