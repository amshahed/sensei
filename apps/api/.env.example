# ---- Core ----
PORT=3000
# Comma-separated allowed origins for CORS. Leave unset to reflect any origin
# (fine for local dev); set to your client origin(s) in production.
CORS_ORIGIN=

# ---- Database: Neon Postgres + pgvector (HITL: provision Neon, paste URL) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth: Clerk (issue #3) ----
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ---- AI: Anthropic via thin LLMClient (issue #8) ----
ANTHROPIC_API_KEY=
# Optional per-task model overrides (defaults: haiku-4-5 / opus-4-8 per L.4).
LLM_GRADING_MODEL=
LLM_AUTHORING_MODEL=

# ---- Embeddings: Voyage AI (issue #21b — voyage-3, 1024-dim) ----
# Sign up at https://voyageai.com; $5 free credit covers the MVP corpus.
VOYAGE_API_KEY=

# ---- Dev auth stub (issue #3 replaces with Clerk) ----
# Override the single dev user the API attributes anonymous requests to. The
# x-dev-user-id header overrides this per-request when set.
DEV_USER_ID=

# ---- Speech: Azure (issues #10 / #11) ----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---- Object storage: Cloudflare R2 (issue #10) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
